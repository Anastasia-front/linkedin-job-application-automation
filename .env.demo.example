# Public demo n8n environment file. NEVER commit the real .env.demo.
# Real values live in AWS SSM Parameter Store under
# /linkedin-job-application-automation/demo/env/<KEY> and are rendered into
# .env.demo on the demo EC2 host by deploy/scripts/deploy-n8n-demo.sh,
# the same way production's .env is rendered by deploy/scripts/deploy-n8n.sh.
#
# Every value here MUST be different from production's (separate encryption
# key, separate DB password, separate hostname). The pinned image tag now
# changes regularly (see n8n-version.txt / .github/workflows/update-n8n-version.yml),
# so verify each flag still exists for whatever is currently pinned via
# `docker run --rm docker.n8n.io/n8nio/n8n:$(cat n8n-version.txt) --help`
# before relying on it; remove/replace anything not supported by that version.

NODE_ENV=production
N8N_HOST=demo-n8n.ai-automation-platform.com
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_EDITOR_BASE_URL=https://demo-n8n.ai-automation-platform.com/
WEBHOOK_URL=https://demo-n8n.ai-automation-platform.com/
N8N_PROXY_HOPS=1

TZ=Europe/Paris
GENERIC_TIMEZONE=Europe/Paris

# Demo-only encryption key. Must never equal production's N8N_ENCRYPTION_KEY.
N8N_ENCRYPTION_KEY=replace-with-a-different-openssl-rand-hex-32-value

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=replace-with-a-demo-only-random-password

# Shared demo login (recruiters use this to sign in). Also demo-only.
DEMO_USER_EMAIL=demo@ai-automation-platform.com
DEMO_USER_PASSWORD=cafD684120322

N8N_RUNNERS_ENABLED=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_USER_MANAGEMENT_DISABLED=false

# Keep the demo database small and free of stale execution history.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=24

# Threat-model hardening for an untrusted, publicly editable instance.
N8N_COMMUNITY_PACKAGES_ENABLED=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true
N8N_RESTRICT_FILE_ACCESS_TO=/tmp/n8n-demo-files
